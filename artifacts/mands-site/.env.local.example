# ── Contact Forms (Formspree) ──────────────────────────────────────────────────
# 1. Create a free account at https://formspree.io
# 2. Create a new form and copy the endpoint URL
# 3. Set the destination email to info@mandsc.com (or wherever submissions should land)
NEXT_PUBLIC_FORMSPREE_CONTACT_URL=https://formspree.io/f/YOUR_FORM_ID

# ── Newsletter Signups (Kit / ConvertKit) ──────────────────────────────────────
# 1. Log in to https://app.kit.com → Settings → Developer → API Keys
# 2. Create an API Key with "Write" access to subscribers
# 3. Get your Form ID from the URL when editing a form: /forms/{FORM_ID}/edit
KIT_API_KEY=your_kit_api_key_here
KIT_FORM_ID=your_kit_form_id_here
